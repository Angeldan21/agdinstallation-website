---
title: "Projects — AGD Installation"
pageKey: projects
permalink: "projects.html"
---
{% extends "base.njk" %}

{% block style %}
<style>
  .page-hero {
    padding: 80px 0 48px;
    border-bottom: 1px solid var(--line);
  }
  .page-hero .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
  }
  .page-hero h1 { font-size: clamp(48px, 7vw, 96px); }
  .page-hero p { color: var(--muted); font-size: 18px; line-height: 1.6; max-width: 480px; }
  @media (max-width: 900px) { .page-hero .row { grid-template-columns: 1fr; } }

  .filter-bar {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .filter-bar button {
    padding: 8px 16px;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    font-family: 'Inter', sans-serif;
    color: var(--ink-2);
    cursor: pointer;
    transition: all .15s ease;
  }
  .filter-bar button.on,
  .filter-bar button:hover {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }

  .proj-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
    padding: 48px 0 80px;
  }
  .proj {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    gap: 16px;
    cursor: pointer;
  }
  .proj.wide { grid-column: span 12; }
  .proj.third { grid-column: span 4; }
  .proj .photo { aspect-ratio: 4/3; transition: transform .3s ease; overflow: hidden; }
  .proj.wide .photo { aspect-ratio: 21/9; }
  .proj:hover .photo { transform: scale(1.01); }
  .proj .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .proj .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .proj .mono { font-size: 11px; }
  .proj h3 {
    font-size: 22px;
    line-height: 1.2;
  }
  .proj p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }
  @media (max-width: 900px) {
    .proj, .proj.wide, .proj.third { grid-column: span 12; }
  }

  /* Big feature */
  .feature {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    padding: 80px 0;
    border-top: 1px solid var(--line);
    align-items: center;
  }
  .feature .photo { aspect-ratio: 4/5; }
  .feature .meta-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 32px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .feature .meta-row > div {
    padding: 20px 20px 20px 0;
    border-right: 1px solid var(--line);
  }
  .feature .meta-row > div:last-child { border-right: none; }
  .feature .meta-row .mono { font-size: 11px; margin-bottom: 6px; display:block; }
  .feature .meta-row strong { font-family: 'Sora', sans-serif; font-size: 18px; font-weight: 600; }
  @media (max-width: 900px) { .feature { grid-template-columns: 1fr; } }
</style>
{% endblock %}

{% block body %}
<main>
  <section class="page-hero">
    <div class="container">
      <div class="row">
        <div>
          <span class="eyebrow">Projects</span>
          <h1 style="margin-top:24px;">Moves that didn't miss a Monday.</h1>
        </div>
        <div>
          <p>A selection of recent commercial jobs across the Bay Area and greater California — from two-person startups to 200-desk relocations.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="filter-bar">
        <button class="on" data-filter="all">All</button>
        <button data-filter="relocation">Relocation</button>
        <button data-filter="install">Installation</button>
        <button data-filter="systems">Cubicle systems</button>
        <button data-filter="decom">Decommissioning</button>
      </div>

      <div class="proj-grid" id="projGrid">
        {% for p in projects.items %}
        <a class="proj{% if p.size == 'wide' %} wide{% elif p.size == 'third' %} third{% endif %}" data-cat="{{ p.category }}">
          <div class="photo">
            {% if p.image %}<img src="{{ p.image }}" alt="{{ p.title }}">{% else %}<div class="photo-label">{{ p.categoryLabel }} · photo</div>{% endif %}
          </div>
          <div class="meta">
            <div>
              <span class="mono">{{ p.year }} · {{ p.city }}</span>
              <h3 style="margin-top:6px;">{{ p.title }}</h3>
            </div>
            <span class="mono">{{ p.categoryLabel }}</span>
          </div>
          <p>{{ p.description }}</p>
        </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Feature case study -->
  <section style="background: var(--cream);">
    <div class="container feature">
      <div class="photo"><div class="photo-label">Case study · 4:5 photo</div></div>
      <div>
        <span class="eyebrow">Case study</span>
        <h2 style="margin-top:20px; font-size: clamp(32px, 4vw, 48px);">"They moved our office over a weekend and nobody on my team noticed."</h2>
        <div class="meta-row">
          <div><span class="mono">Client</span><strong>Crestline &amp; Co.</strong></div>
          <div><span class="mono">Scope</span><strong>42,000 sq ft</strong></div>
          <div><span class="mono">Duration</span><strong>48 hours</strong></div>
        </div>
        <p style="color: var(--ink-2); line-height: 1.6; margin-bottom: 20px;">
          180 workstations, 12 conference rooms, a full kitchen and lounge — all moved, installed, and reset across a single weekend. The AGD team labeled every item, mapped every seat, and handled the building COI and elevator coordination. Monday morning, 9:00, everyone at their new desk with their monitors plugged in.
        </p>
        <a href="contact.html" class="btn btn-outline">Start yours →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="border-top: none;">
    <div class="container" style="text-align:center; max-width: 720px;">
      <h2>Have a project in mind?</h2>
      <p style="color: var(--muted); font-size: 18px; line-height: 1.6; margin: 20px auto 32px;">
        From a single install to a full-building move, we'd love to take a look.
      </p>
      <a href="contact.html" class="btn btn-primary">Request a quote →</a>
    </div>
  </section>
</main>
{% endblock %}

{% block scripts %}
<script>
  // Filter bar
  document.querySelectorAll('.filter-bar button').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-bar button').forEach(b => b.classList.remove('on'));
      btn.classList.add('on');
      const f = btn.dataset.filter;
      document.querySelectorAll('.proj').forEach(p => {
        p.style.display = (f === 'all' || p.dataset.cat === f) ? '' : 'none';
      });
    });
  });
</script>
{% endblock %}
