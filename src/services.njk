---
title: "Services — AGD Installation"
pageKey: services
permalink: "services.html"
---
{% extends "base.njk" %}

{% block style %}
<style>
  .page-hero {
    padding: 80px 0 72px;
    border-bottom: 1px solid var(--line);
  }
  .page-hero .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
  }
  .page-hero h1 { font-size: clamp(48px, 7vw, 96px); }
  .page-hero p { color: var(--muted); font-size: 18px; line-height: 1.6; max-width: 480px; }
  @media (max-width: 900px) { .page-hero .row { grid-template-columns: 1fr; } }

  .svc-row {
    display: grid;
    grid-template-columns: 80px 1fr 1.2fr;
    gap: 48px;
    padding: 56px 0;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .svc-row:last-child { border-bottom: 1px solid var(--line); }
  .svc-row .num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.1em;
    padding-top: 8px;
  }
  .svc-row h2 { font-size: 36px; line-height: 1.05; }
  .svc-row .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }
  .svc-row .lede {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
    margin-bottom: 20px;
  }
  .svc-row ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .svc-row ul li {
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 15px;
    display: flex;
    gap: 12px;
  }
  .svc-row ul li::before {
    content: '→';
    color: var(--accent);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .svc-row { grid-template-columns: 1fr; gap: 20px; padding: 40px 0; }
  }

  .capabilities {
    background: var(--ink);
    color: #fff;
    padding: 100px 0;
  }
  .capabilities .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 56px;
  }
  .capabilities .cap {
    padding: 28px 24px 28px 0;
    border-top: 1px solid #2a2a2a;
  }
  .capabilities .cap:nth-child(3n) { padding-right: 0; }
  .capabilities .cap h4 {
    color: #fff;
    font-size: 18px;
    margin-bottom: 8px;
    font-family: 'Sora', sans-serif;
    font-weight: 600;
  }
  .capabilities .cap p {
    color: #9a9a9a;
    font-size: 14px;
    line-height: 1.5;
  }
  @media (max-width: 900px) { .capabilities .grid { grid-template-columns: 1fr; } }
</style>
{% endblock %}

{% block body %}
<main>
  <section class="page-hero">
    <div class="container">
      <div class="row">
        <div>
          <span class="eyebrow">Services</span>
          <h1 style="margin-top:24px;">Commercial, only.<br/>On schedule, always.</h1>
        </div>
        <div>
          <p>Five core services, one Hayward-based crew. We scope each project with a walkthrough, give you a firm number, and put the same supervisor on the job from first visit to final signoff.</p>
          <div style="margin-top:24px;">
            <a href="contact.html" class="btn btn-primary">Request a quote →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="padding: 0 0 80px;">
    <div class="container">

      {% for s in services.items %}
      <div class="svc-row">
        <div class="num">{{ s.num }}</div>
        <div>
          <h2>{{ s.title }}</h2>
          <div class="tags">
            {% for t in s.tags %}<span class="badge">{{ t }}</span>{% endfor %}
          </div>
        </div>
        <div>
          <p class="lede">{{ s.lede }}</p>
          <ul>
            {% for b in s.bullets %}<li>{{ b }}</li>{% endfor %}
          </ul>
        </div>
      </div>
      {% endfor %}

    </div>
  </section>

  <!-- Capabilities -->
  <section class="capabilities">
    <div class="container">
      <div style="max-width: 720px;">
        <span class="eyebrow" style="color:#9a9a9a;"><span style="background:#9a9a9a; width:24px; height:1px; display:inline-block;"></span>Capabilities</span>
        <h2 style="margin-top:20px; color:#fff;">What we bring to every job.</h2>
      </div>
      <div class="grid">
        <div class="cap"><h4>Licensed &amp; insured</h4><p>$5M general liability. Certificates sent same-day to your building.</p></div>
        <div class="cap"><h4>Uniformed crews</h4><p>Branded shirts, IDs, and a supervisor on site for every job over four hours.</p></div>
        <div class="cap"><h4>Right-sized fleet</h4><p>Box trucks, 26-foot straight trucks, and trailers — whatever the job needs.</p></div>
        <div class="cap"><h4>Protective gear</h4><p>Moving pads, shrink wrap, masonite, floor runners, elevator pads.</p></div>
        <div class="cap"><h4>Labeled inventory</h4><p>Every item tagged, every room mapped. Nothing arrives in the wrong place.</p></div>
        <div class="cap"><h4>After-hours work</h4><p>Evenings, weekends, and holidays. Your business keeps running.</p></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-cream" style="border-top: none;">
    <div class="container" style="text-align:center; max-width: 720px;">
      <span class="eyebrow" style="justify-content:center;">Next step</span>
      <h2 style="margin-top:20px;">Start with a walkthrough.</h2>
      <p style="color: var(--ink-2); font-size: 18px; line-height: 1.6; margin: 20px auto 32px;">
        Tell us about your space and your timeline. We'll come see it, give you a firm quote, and put a plan on paper.
      </p>
      <a href="contact.html" class="btn btn-primary">Request a quote →</a>
    </div>
  </section>
</main>
{% endblock %}
